# NON-SECRET LOCAL REHEARSAL TEMPLATE. Not a deployable production profile.
# See docs/V2_STAGING_TOPOLOGY.md. Do not copy production .env files.
# Required DATABASE_URL, SECRET_KEY and INTEGRATION_ENCRYPTION_KEY intentionally
# omitted: inject new staging-only credentials from a local secret manager.
APP_ENV=staging
DEBUG=false
AUTO_CREATE_TABLES=false
ALLOW_LEGACY_ENV_CREDENTIALS=false
AUTH_ADMISSION_STORE=database
AUTH_PEER_LIMIT=30
AUTH_GLOBAL_LIMIT=300
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
GTM_LOCAL_MODEL_URL=http://127.0.0.1:11434
GTM_LOCAL_MODEL=qwen3:4b
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_NO_CLOUD=1
VITE_API_BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth/google/callback
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
APOLLO_API_KEY=
CLEARBIT_API_KEY=
PDL_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_USER=
SMTP_PASS=
HUBSPOT_API_KEY=
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_ACCESS_TOKEN=
PINECONE_API_KEY=
